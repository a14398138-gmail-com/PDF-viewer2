<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirrors backup_rules.xml: saved PDF copies, thumbnails and the cache
  (which may contain decrypted plaintext PDFs) never leave the device via
  cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="saved_pdfs/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="saved_pdfs/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
